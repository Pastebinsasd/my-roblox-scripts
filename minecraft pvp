local function bindMacToggle(section, mod)
    local t = section:Toggle({
        Name = mod.name,
        Default = CFG[mod.cfgKey],
        Callback = function(v)
            mod:SetState(v, false)
        end
    })
    mod.macToggle = t
    return t
end

