local function formatKeyName(keyCode)
    if not keyCode or keyCode == Enum.KeyCode.Unknown then
        return "None"
    end
    local name = keyCode.Name
    local shortMap = {
        RightControl = "RCtrl",
        LeftControl  = "LCtrl",
        RightShift   = "RShift",
        LeftShift    = "LShift",
        RightAlt     = "RAlt",
        LeftAlt      = "LAlt",
        CapsLock     = "Caps",
        Backquote    = "Grave",
    }
    return shortMap[name] or name
end

